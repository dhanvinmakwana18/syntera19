# Syntera Backend Configuration (Example)

# LLM Provider Configuration
# Supported providers: ollama, gemini, astra, openai
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_MODEL=llama3

# API Keys (Keep these private, do not commit!)
OPENAI_API_KEY=xpl_placeholder_key_here
ASTRA_API_KEY=xpl_placeholder_key_here

# Astra / GPT-6 Custom Configuration
ASTRA_MODEL=gpt-6-astra
ASTRA_TEMPERATURE=0.2
ASTRA_MAX_RETRIES=3

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
